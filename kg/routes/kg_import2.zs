# 知识图谱导入，用引擎自己写（原来是 Python：tools/kg_dag.py）。
#
# 顺序是有讲究的：
#   节点 → 条目 → 边 → 对照
#   条目的 point 指向节点（外键），所以节点要先；
#   对照的两端可能是条目（なければならない ↔ なくてもいい），所以对照要后；
#   边放在条目之后没有硬性要求，但这样一趟读完三个文件更顺。
#
# **加边走 kg_edge_add.sql，那条 SQL 自带环检查**：会成环就影响 0 行。
# 被拒之后再查 kg_edge_why 问原因，成环的还查一次 kg_path 拿到库里那条
# 已有的路径——「c → a 被拒，因为库里已经有 a → b → c」比只说「会成环」
# 有用得多。
#
# 整个导入在一个事务里：文件中途坏掉全部回滚，不会导一半。被拒的边不算
# 意外，照常提交。

接口 POST /kg/import2 动作 kg_import2
  用包 common db http

  读JSONL 节点表 = content/kg.jsonl
  读JSONL 条目表 = content/items.jsonl
  读JSONL 对照表 = content/contrast.jsonl

  设 节点数 = 0
  设 条目数 = 0
  设 边数 = 0
  设 已有 = 0
  设 拒绝 = 0
  设 对照数 = 0
  设 说明 = 

  事务 app.db
    # 一、节点。先全部插入，文件里可以先引用后定义
    遍历 项 于 {节点表} 序号 行
      设 点.code = {项.id 或}
      设 点.label = {项.label 或}
      如果 {点.code} 为空
        设 说明 = {说明} 第{行}行缺 id；
      否则
        设 影响 = 写库表 app.db kg_node_upsert {点}
        设 节点数 = 相加 {节点数} 1
      结束
    结束

    # 二、条目。point 指向节点，所以要在节点之后
    遍历 条 于 {条目表} 序号 行
      设 目.code = {条.code 或}
      设 目.label = {条.label 或}
      设 目.point = {条.point 或}
      设 目.form = {条.form 或}
      设 目.after = {条.after 或}
      如果 {目.code} 为空
        设 说明 = {说明} 条目第{行}行缺 code；
      否则
        设 影响 = 写库表 app.db item_upsert {目}
        设 条目数 = 相加 {条目数} 1
      结束
    结束

    # 三、前置边。SQL 自带环检查，被拒的逐条问原因
    遍历 项 于 {节点表} 序号 行
      遍历 前 于 {项.prereq 或}
        设 边.src = {前}
        设 边.dst = {项.id}
        设 影响 = 写库表 app.db kg_edge_add {边}
        如果 {影响} 等于 1
          设 边数 = 相加 {边数} 1
        否则
          设 原因 = 查一值表 app.db kg_edge_why {边}
          如果 {原因} 等于 已存在
            设 已有 = 相加 {已有} 1
          否则
            设 拒绝 = 相加 {拒绝} 1
            设 查路.from = {项.id}
            设 查路.to = {前}
            设 路径 = 查一值表 app.db kg_path {查路}
            设 说明 = {说明} 第{行}行 {前}→{项.id} {原因}{路径}；
          结束
        结束
      结束
    结束

    # 四、对照。两端可以是节点也可以是条目，所以放在最后
    遍历 对 于 {对照表} 序号 行
      设 双.x = {对.a 或}
      设 双.y = {对.b 或}
      设 影响 = 写库表 app.db kg_contrast_add {双}
      设 对照数 = 相加 {对照数} {影响}
    结束
  结束

  返回 {"nodes":"{节点数}","items":"{条目数}","edges":"{边数}","existing":"{已有}","rejected":"{拒绝}","contrast":"{对照数}","note":"{说明}"}
结束
