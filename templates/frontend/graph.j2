<% from "widgets.j2" import 当, 尺寸 with context %>
{#- 「图」控件。单独一个文件：它是唯一带外部依赖（Vue Flow + dagre）的
    控件，分开放好找也好删。

    数据形状（从「绑」指定的共享路径读）：

        shared.graph = {
          nodes: [{ id, label, x?, y?, width?, height?, ...自定义 }],
          edges: [{ from, to, id?, label? }]
        }

    id / label / from / to 是引擎认的，其余字段原样带着——点节点时整个
    节点对象写进「选中」指定的路径，后端塞什么额外信息都拿得到。

    节点给了 x/y 就按给的放，没给才跑 dagre 算。后端想按业务含义排布
    就自己定坐标，不想管就不管。

    点击不新造事件机制：节点数据写进共享状态，之后用「当 shared.sel」
    控制按钮显隐、用「显示 sel.label」展示内容，都是现成词汇。点空白
    处清掉选中。

    只读：nodes-draggable / nodes-connectable 都关掉。要编辑图的话得
    先想清楚改动怎么回传后端，那是另一件事。 -#}
<%- macro 节点图(n) -%>
<%- set path = n.bind or n.name -%>
<%- set dir = n.direction or "纵向" -%>
<div class="graph-wrap"<%= 当(n) %><%= 尺寸(n) %>>
<VueFlow
  :nodes="graphOf('<%= path %>', '<%= dir %>').nodes"
  :edges="graphOf('<%= path %>', '<%= dir %>').edges"
  :nodes-draggable="false"
  :nodes-connectable="false"
  :elements-selectable="true"
  fit-view-on-init
  @node-click="onGraphNode('<%= n.selects %>', $event)"
  @pane-click="onGraphNode('<%= n.selects %>', null)" />
</div>
<%- endmacro -%>
