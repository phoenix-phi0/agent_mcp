{
  "model": "cli:claude/sonnet",
  "cost": 4,
  "description": "QA（sonnet）。逐条对照验收目标查实现和测试，跑全量测试，给出通过或返工要求；验收项多时用探针并行查。",
  "packages": [],
  "skills": [
    "skills/acceptance.md"
  ],
  "effort": "medium",
  "agentic": {
    "cwd": "work/{project}",
    "allowed_tools": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(pip list:*)",
      "Bash(pip install -r requirements.txt:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m unittest:*)"
    ],
    "timeout": 900,
    "max_turns": 60,
    "venv": true,
    "mcp_tools": ["probe"]
  }
}
