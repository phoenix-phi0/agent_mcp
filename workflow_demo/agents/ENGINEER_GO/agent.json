{
  "model": "cli:claude/sonnet",
  "cost": 3,
  "description": "Go 项目专用的中档工程师（sonnet）。只用于 Go 项目：一般的模块实现，几个函数、几种错误、要读懂已有代码再配合着写；能跑 go test / go vet / gofmt，带探针和提交前的独立审查。不要派给 Python 或其他语言的项目。",
  "packages": [],
  "skills": [
    "skills/implementation.md"
  ],
  "effort": "high",
  "agentic": {
    "cwd": "work/{project}",
    "allowed_tools": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(go version:*)",
      "Bash(go mod init:*)",
      "Bash(go mod tidy:*)",
      "Bash(go get:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(gofmt:*)"
    ],
    "timeout": 1200,
    "max_turns": 60,
    "venv": false,
    "mcp_tools": [
      "probe",
      "review"
    ]
  },
  "category": "实现"
}
