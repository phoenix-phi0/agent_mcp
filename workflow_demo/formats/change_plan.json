{
  "type": "object",
  "description": "改已有项目的改动方案：在项目的接口约定（CONTRACT.json）上改。只列要改、要新增的模块（整份新版本）；没列的模块一律不动、接口保持原样。合并回约定时按 order 排模块。修改版带 changes。",
  "additionalProperties": false,
  "required": [
    "summary",
    "project_summary",
    "order",
    "modules",
    "removed",
    "layout",
    "data_model",
    "integration",
    "conventions",
    "keep",
    "risks",
    "open_questions"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "这次改了什么，几句话"
    },
    "project_summary": {
      "type": "string",
      "minLength": 1,
      "description": "改完以后整个项目是什么样（替换约定里的 summary）"
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "改完以后全部模块的顺序（原有的、新增的都写，删除的不写），按依赖排：前面的不依赖后面的"
    },
    "modules": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "responsibility",
          "files",
          "depends_on",
          "provides",
          "uses",
          "acceptance",
          "tests",
          "status",
          "change"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "模块标识，小写英文"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1,
            "description": "只负责什么、不负责什么"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "这个模块会新建或修改的文件"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "依赖的模块名（必须排在前面）"
          },
          "provides": {
            "type": "array",
            "description": "对外提供的接口：别的模块或用户会用到的都写",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind",
                "signature",
                "behavior",
                "errors"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "函数",
                    "类",
                    "HTTP接口",
                    "命令",
                    "页面",
                    "数据表",
                    "配置",
                    "其他"
                  ]
                },
                "signature": {
                  "type": "string",
                  "minLength": 1,
                  "description": "函数签名 / 类的公开方法 / HTTP 方法+路径+请求和响应 JSON / 命令行参数 / 页面路由"
                },
                "behavior": {
                  "type": "string",
                  "minLength": 1
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "错误码或异常，和触发条件"
                }
              }
            }
          },
          "uses": {
            "type": "array",
            "description": "用到的别的模块的接口：照抄对方 provides 里的约定（签名、行为、错误），工程师只看得到本模块，靠这里知道怎么调",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "signature",
                "behavior",
                "errors"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*\\..+$",
                  "description": "模块名.接口名，必须是前面模块 provides 里有的"
                },
                "signature": {
                  "type": "string",
                  "minLength": 1,
                  "description": "和对方 provides 里的签名一字不差"
                },
                "behavior": {
                  "type": "string",
                  "minLength": 1
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "这个模块做完的验收条件，能用测试或命令验证"
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "要写的测试：测试文件名和要覆盖的行为"
          },
          "status": {
            "enum": [
              "新增",
              "修改"
            ],
            "description": "修改 = 原约定里有的模块（整份写出改后的新版本）；新增 = 新模块"
          },
          "change": {
            "type": "string",
            "minLength": 1,
            "description": "和原约定比改了什么：哪些接口新增 / 改了签名或行为 / 删了，为什么；新增模块写它要做什么"
          }
        }
      },
      "description": "要改和要新增的模块，按 order 的先后排；每项是这个模块完整的新约定。没列的模块不动"
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "要删掉的模块（写理由）；一般为空"
    },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "purpose"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "相对项目根的目录或文件"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "改完以后完整的目录（原样的也写）"
    },
    "data_model": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "fields",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "表 / 实体 / 主要数据结构"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "每条「字段名 类型 约束」"
          },
          "notes": {
            "type": "string",
            "description": "唯一性、外键、索引、生命周期"
          }
        }
      },
      "description": "改完以后完整的数据模型（原样的也写）；加列、改表时在 keep 里写清旧数据怎么迁移"
    },
    "integration": {
      "type": "array",
      "minItems": 1,
      "description": "改完以后完整的端到端场景：原有的照写，新增或改了的写清；集成验收逐条走",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "全项目约定（原样的也写）"
    },
    "keep": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "这次明确保持不变、验收时要核对的：老接口的兼容、已有数据、已有测试的断言等"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "description": "修改版才写：逐条回应评审结论",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue",
          "action",
          "detail"
        ],
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "已修改",
              "不修改"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
