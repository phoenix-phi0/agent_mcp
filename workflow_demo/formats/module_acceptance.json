{
 "type": "object",
 "description": "模块验收：以架构里这个模块的约定为准（provides、uses、acceptance、tests）逐条核对。实现和约定不一致就是不满足，写进 deviations，判需修改。checked 里有一项不满足或未验证，就不能判通过。 not_verified 不为空也不能判通过；判满足的项，证据必须是这次亲眼看到的。",
 "additionalProperties": false,
 "required": [
  "decide",
  "summary",
  "checked",
  "not_verified",
  "deviations"
 ],
 "properties": {
  "decide": {
   "enum": [
    "通过",
    "需修改"
   ]
  },
  "summary": {
   "type": "string",
   "minLength": 1
  },
  "checked": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item",
     "result",
     "evidence"
    ],
    "properties": {
     "item": {
      "type": "string",
      "minLength": 1
     },
     "result": {
      "enum": [
       "满足",
       "不满足",
       "未验证"
      ]
     },
     "evidence": {
      "type": "string",
      "description": "这次自己用工具看到的事实：文件:行、引用的代码或断言、测试名。没亲眼看到的不能判满足"
     }
    },
    "allOf": [
     {
      "if": {
       "properties": {
        "result": {
         "const": "满足"
        }
       },
       "required": [
        "result"
       ]
      },
      "then": {
       "properties": {
        "evidence": {
         "not": {
          "pattern": "只看到.{0,8}(函数名|名字|名称|测试名)|(没有?|未)(读|打开)(过|它|该|这|测试|断言|代码)|未核对|没能(核对|读|打开)|无法核对"
         },
         "description": "判满足的证据里不能有「只看到函数名」「没读断言」「未核对」这类话：没看到就判未验证"
        }
       }
      }
     }
    ]
   }
  },
  "not_verified": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "没能核对的项（含环境限制导致没法核对的）。判通过时必须为空"
  },
  "deviations": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "实现和约定不一致的地方（接口名、参数、返回、错误、数据结构），每条写约定是什么、代码里是什么、在哪个文件。有一条就不能判通过"
  },
  "task": {
   "type": "string",
   "minLength": 1,
   "description": "自包含的返工要求：修什么、期望行为、修完怎么证明。需修改时必填"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "decide": {
      "const": "需修改"
     }
    },
    "required": [
     "decide"
    ]
   },
   "then": {
    "required": [
     "task"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "decide": {
      "const": "通过"
     }
    },
    "required": [
     "decide"
    ]
   },
   "then": {
    "properties": {
     "checked": {
      "items": {
       "properties": {
        "result": {
         "const": "满足"
        }
       }
      }
     },
     "deviations": {
      "maxItems": 0
     },
     "not_verified": {
      "maxItems": 0
     }
    }
   }
  }
 ]
}
