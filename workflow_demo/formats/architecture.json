{
  "type": "object",
  "description": "整个项目的架构设计：模块划分（按依赖排好）、模块之间的接口、数据模型、目录、集成场景。修改版带 changes。",
  "additionalProperties": false,
  "required": ["summary", "stack", "layout", "data_model", "modules", "integration", "conventions", "risks", "open_questions"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "description": "项目要做成什么样，几句话"},
    "stack": {"type": "string", "minLength": 1, "description": "具体到库和版本的技术选型、怎么启动、怎么跑测试"},
    "layout": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "description": "相对项目根的目录或文件"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "data_model": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "fields", "notes"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "description": "表 / 实体 / 主要数据结构"},
          "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
                     "description": "每条「字段名 类型 约束」"},
          "notes": {"type": "string", "description": "唯一性、外键、索引、生命周期"}
        }
      }
    },
    "modules": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "description": "按依赖顺序排：前面的不依赖后面的；第一个模块负责项目骨架（目录、依赖文件、配置、测试框架，整体测试命令能跑通）",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "title", "responsibility", "files", "depends_on", "provides", "uses", "acceptance", "tests"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "模块标识，小写英文"},
          "title": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1, "description": "只负责什么、不负责什么"},
          "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
                    "description": "这个模块会新建或修改的文件"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "description": "依赖的模块名（必须排在前面）"},
          "provides": {
            "type": "array",
            "description": "对外提供的接口：别的模块或用户会用到的都写",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "kind", "signature", "behavior", "errors"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "kind": {"enum": ["函数", "类", "HTTP接口", "命令", "页面", "数据表", "配置", "其他"]},
                "signature": {"type": "string", "minLength": 1,
                              "description": "函数签名 / 类的公开方法 / HTTP 方法+路径+请求和响应 JSON / 命令行参数 / 页面路由"},
                "behavior": {"type": "string", "minLength": 1},
                "errors": {"type": "array", "items": {"type": "string"}, "description": "错误码或异常，和触发条件"}
              }
            }
          },
          "uses": {"type": "array", "items": {"type": "string"}, "description": "用到的别的模块的接口，写「模块名.接口名」"},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
                         "description": "这个模块做完的验收条件，能用测试或命令验证"},
          "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
                    "description": "要写的测试：测试文件名和要覆盖的行为"}
        }
      }
    },
    "integration": {
      "type": "array", "minItems": 1,
      "description": "跨模块的端到端场景：所有模块做完后整体验收逐条走",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "steps", "expected"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expected": {"type": "string", "minLength": 1}
        }
      }
    },
    "conventions": {"type": "array", "items": {"type": "string"},
                    "description": "全项目统一的约定：错误怎么报、命名、配置从哪读、日志"},
    "risks": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "changes": {
      "type": "array",
      "description": "修改版才写：逐条回应审查意见",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issue", "action", "detail"],
        "properties": {
          "issue": {"type": "string", "minLength": 1},
          "action": {"enum": ["已修改", "不修改"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
