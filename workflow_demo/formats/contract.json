{
  "type": "object",
  "description": "接口约定：架构师交给审查员和工程师的设计。",
  "additionalProperties": false,
  "required": ["contract"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "constraints", "interfaces", "invariants", "acceptance", "risks", "open_questions"],
      "properties": {
        "goal": {"type": "string", "minLength": 1, "description": "要解决的问题，一句话"},
        "constraints": {"type": "array", "items": {"type": "string"}, "description": "约束（技术栈、不能依赖外部服务等）"},
        "interfaces": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "input", "output", "errors"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "input": {"type": "object", "description": "字段 → 「类型，必填/可选，规则」"},
              "output": {"type": "object", "description": "字段 → 类型"},
              "errors": {
                "type": "array",
                "items": {"type": "object", "required": ["code", "when"],
                          "properties": {"code": {"type": "string", "minLength": 1},
                                         "when": {"type": "string", "minLength": 1}}}
              },
              "permissions": {"type": "string", "description": "谁能调用"}
            }
          }
        },
        "invariants": {"type": "array", "items": {"type": "string"}, "description": "任何情况下都必须成立的规则"},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"},
                       "description": "可验证的验收条件，能判断真假的句子"},
        "risks": {"type": "array", "items": {"type": "string"}},
        "open_questions": {"type": "array", "items": {"type": "string"}, "description": "未决问题和做的假设"}
      }
    }
  }
}
